<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Consultation Reminder</title>
    <style>
      /* General Styles */
      body {
        font-family: Arial, sans-serif;
        background-color: #f4f4f4;
        margin: 0;
        padding: 0;
      }
      .email-container {
        width: 100%;
        padding: 20px;
        background-color: #ffffff;
        border-radius: 8px;
        margin: 0 0;
        max-width: 800px;
      }
      .header {
        text-align: left;
        margin-bottom: 20px;
      }
      .header h1 {
        color: #4caf50;
        font-size: 24px;
      }
      .content {
        margin-bottom: 20px;
        text-align: left;
      }
      .content p {
        font-size: 16px;
        line-height: 1.5;
      }
      .content ul {
        font-size: 16px;
        line-height: 1.5;
        padding-left: 20px;
      }
      .footer {
        font-size: 12px;
        color: #777;
        text-align: left;
        margin-top: 30px;
      }

      /* Responsive Styles */
      @media screen and (max-width: 600px) {
        .email-container {
          width: 100% !important;
          padding: 15px;
        }
        .header h1 {
          font-size: 20px;
        }
        .content p,
        .content ul {
          font-size: 14px;
        }
        .footer {
          font-size: 10px;
        }
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <div class="content">
        <p>Hi <strong><%= userName %></strong>,</p>
        <p>You have a consultation call today!</p>
        <ul>
          <li><strong>Counsellor's Name:</strong> <%= counsellorName %></li>
          <li><strong>Date:</strong> <%= scheduledDate %></li>
          <li><strong>Time:</strong> <%= consultTime %> IST</li>
        </ul>
        <p>
          <%= counsellorName %> will call you today at the above-mentioned time
          on your given mobile number.
        </p>
        <p>
          You can get in touch with her on WhatsApp as well on:
          <a href="https://wa.me/<%= counsellorPhone %>" target="_blank">
            <%= counsellorPhone %>
          </a>
        </p>
      </div>
      <div class="footer">
        <p>© <%= year %> Balance Nutrition. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
