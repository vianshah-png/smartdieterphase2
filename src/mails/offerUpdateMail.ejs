<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>BN Wallet Expiry Reminder</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f4f4;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f4f4f4; padding: 30px 0;">
      <tr>
        <td align="center">
          <table width="600" cellpadding="20" cellspacing="0" border="0" style="background-color: #ffffff; border-radius: 10px; font-family: 'Segoe UI', sans-serif; box-shadow: 0 0 12px rgba(0,0,0,0.08);">
            <tr>
              <td>

                <p style="font-size: 16px; color: #333;">Hi <%= userName %>,</p>

                <p style="font-size: 16px; color: #333;">
                  An urgent reminder, <strong>Rs.<%= userWallet %> in your BN Wallet is expiring TONIGHT.</strong>
                </p>

                <p style="font-size: 16px; color: #333;">
                  This is your last chance in <%= year %> to get the programs at these lowest rates.
                </p>

                <!-- CTA Button -->
                <div style="font-size: 16px; color: #333;">
                  Check your total discounted price here : <a href="<%= suggLink %>" style="display: inline-block; background-color: #1976d2; color: #ffffff; padding: 8px 16px; font-size: 10px; border-radius: 5px; text-decoration: none;">
                    👉 Click Here
                  </a>
                </div>

                <!-- WhatsApp Contact with phone first, then icon and link -->
                <p style="font-size: 16px; color: #333;">
                  WhatsApp your mentor <%= mentorName %> ASAP on:
                  <strong><%= mentorPhone %></strong>
                  <a href="https://wa.me/<%= mentorPhone %>" style="color: #1976d2; text-decoration: none; margin-left: 6px;">
                     (Click here)
                  </a>
                </p>

                <!-- Footer -->
                <p style="font-size: 12px; color: #bbb; text-align: center; margin-top: 30px;">
                  © <%= year %> Balance Nutrition. All rights reserved.
                </p>

              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
