<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      body {
        font-family: Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
        background-color: #ffffff;
        color: #202020;
      }
      .container {
        max-width: 600px;
        margin: 10px auto;
        background-color: #ffffff;
        padding: 20px;
      }
      .logo {
        text-align: center;
        padding: 10px 0;
      }
      .message {
        padding: 0 18px;
        font-size: 16px;
        line-height: 150%;
      }
      .login-box {
        background-color: #ccfdff;
        padding: 18px;
        margin: 10px 18px;
        font-family: Verdana, Geneva, sans-serif;
        line-height: 200%;
        color: #030303;
      }
      .link {
        color: #1a7e8b;
        font-weight: bold;
        text-decoration: none;
      }
      .contact {
        color: #008080;
        font-weight: bold;
      }
      .signature {
        text-align: right;
        margin-top: 20px;
      }
      .divider {
        border-top: 1px dashed #25948b;
        margin: 10px 18px;
      }
      .social-links {
        text-align: center;
        padding: 10px 0;
      }
      .social-links img {
        width: 24px;
        height: 24px;
        margin: 0 5px;
      }
      .footer {
        text-align: center;
        font-size: 13px;
        color: #666666;
        padding: 10px 18px;
        font-family: "Lucida Sans", sans-serif;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Logo -->
      <div class="logo">
        <a href="https://www.balancenutrition.in" target="_blank">
          <img
            src="https://www.bncleanse.com/images/emails/balance-nutrition-logo-new.png"
            alt="Balance Nutrition Logo"
            width="200"
          />
        </a>
      </div>

      <!-- Welcome Message with App Link -->
      <div class="message">
        <p>Dear <%= firstName %>,</p>
        <p>
          Thank you for registering with Balance Nutrition. To get started,
          please download the BN Client Exclusive App on your phone:
          <a href="https://www.balancenutrition.in/download-bn-app" class="link"
            >https://www.balancenutrition.in/download-bn-app</a
          >
        </p>
      </div>

      <!-- Login Details -->
      <div class="login-box">
        <strong>Username:</strong> <%= username %><br />
        <strong>Password:</strong> <%= password %>
      </div>

      <!-- Contact Info -->
      <div class="message">
        <p>
          In case you have any questions, please email the client service team
          at
          <a href="mailto:clientservices@balancenutrition.in" class="link"
            >clientservices@balancenutrition.in</a
          >
          or WhatsApp/call on <span class="contact">+91 89280 01617</span>.
          Kajal from our team shall be happy to help you.
        </p>
        <div class="signature">
          Warm Regards,<br />
          <strong>Team Balance Nutrition</strong>
        </div>
      </div>

      <!-- Divider -->
      <hr class="divider" />

      <!-- Social Media Links -->
      <div class="social-links">
        <a href="https://www.facebook.com/balancenutrition.in" target="_blank">
          <img
            src="https://www.bncleanse.com/images/emails/facebook_n.png"
            alt="Facebook"
          />
        </a>
        <a href="https://twitter.com/balance_khyati" target="_blank">
          <img
            src="https://www.bncleanse.com/images/emails/twitter_n.png"
            alt="Twitter"
          />
        </a>
        <a
          href="https://plus.google.com/+BalanceNutritiononline/posts"
          target="_blank"
        >
          <img
            src="https://www.bncleanse.com/images/emails/google_n.png"
            alt="Google+"
          />
        </a>
        <a
          href="https://in.linkedin.com/in/balance-nutrition-6a65ba98"
          target="_blank"
        >
          <img
            src="https://www.bncleanse.com/images/emails/linkedin_n.png"
            alt="LinkedIn"
          />
        </a>
        <a
          href="https://www.youtube.com/channel/UCRBg_eWt2yJreg8AZXPGvKA"
          target="_blank"
        >
          <img
            src="https://www.bncleanse.com/images/emails/youtube_n.png"
            alt="YouTube"
          />
        </a>
        <a href="https://www.pinterest.com/KhyatiRupani123/" target="_blank">
          <img
            src="https://www.bncleanse.com/images/emails/pinterest_n.png"
            alt="Pinterest"
          />
        </a>
        <a href="https://www.instagram.com/bncleanse.com/" target="_blank">
          <img
            src="https://www.bncleanse.com/images/emails/instagram_n.png"
            alt="Instagram"
          />
        </a>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          <strong>Clients In</strong><br />
          India | UAE | Bahrain | Singapore | USA | UK | Kenya | China & More<br /><br />
          <em>Copyright © Balance Nutrition, All rights reserved.</em>
        </p>
      </div>
    </div>
  </body>
</html>
