<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>On Hold Pregnancy</title>
    <style>
      .email-container {
        font-family: Arial, sans-serif;
        max-width: 600px;
        margin: 0;
        padding: 20px;
      }
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 20px 0;
      }
      th,
      td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
      .bold {
        font-weight: bold;
      }
      .footer {
        text-align: center;
        font-size: 12px;
        color: #666;
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <div class="email-container">
      <%- html %>

      <div class="footer">
        <p>© <%= year %> Balance Nutrition. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
